<resources>
    <color name="pm_background">#F4F7F7</color>
    <color name="pm_surface">#FFFFFF</color>
    <color name="pm_text">#172E36</color>
    <color name="pm_muted">#526871</color>
    <color name="pm_accent">#146B5B</color>
    <color name="pm_on_accent">#FFFFFF</color>
    <color name="pm_accent_soft">#DDEFE8</color>
    <color name="pm_outline">#D5E1DF</color>
    <color name="pm_danger">#AD263C</color>
    <style name="PasswordManagerTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/pm_accent</item>
        <item name="android:windowBackground">@color/pm_background</item>
        <item name="android:colorBackground">@color/pm_background</item>
        <item name="android:textColorPrimary">@color/pm_text</item>
        <item name="android:textColorSecondary">@color/pm_muted</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/pm_background</item>
        <item name="android:navigationBarColor">@color/pm_surface</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
