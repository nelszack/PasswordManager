<resources>
    <style name="AutofillSheet" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowSoftInputMode">stateAlwaysHidden|adjustResize</item>
        <item name="android:windowBackground">@drawable/autofill_sheet</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="android:buttonStyle">@style/AutofillButton</item>
    </style>
    <style name="AutofillButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <color name="autofill_surface">#FAFAFA</color>
</resources>
