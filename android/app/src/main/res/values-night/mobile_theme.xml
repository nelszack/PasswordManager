<resources>
    <color name="pm_background">#121722</color>
    <color name="pm_surface">#171E2C</color>
    <color name="pm_text">#E6ECF7</color>
    <color name="pm_muted">#A7B1C2</color>
    <color name="pm_accent">#9CB7FF</color>
    <color name="pm_on_accent">#121722</color>
    <color name="pm_accent_soft">#253252</color>
    <color name="pm_outline">#2E384A</color>
    <!-- Field and card outlines: at least 3:1 against the surface. -->
    <color name="pm_edge">#8C99AF</color>
    <color name="pm_danger">#FF9B91</color>
    <style name="PasswordManagerTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/pm_accent</item>
        <item name="colorOnPrimary">@color/pm_on_accent</item>
        <item name="colorPrimaryContainer">@color/pm_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/pm_text</item>
        <item name="colorSecondaryContainer">@color/pm_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/pm_text</item>
        <item name="colorSurface">@color/pm_surface</item>
        <item name="colorOnSurface">@color/pm_text</item>
        <item name="colorOnSurfaceVariant">@color/pm_muted</item>
        <item name="colorOutline">@color/pm_edge</item>
        <item name="colorOutlineVariant">@color/pm_outline</item>
        <item name="colorError">@color/pm_danger</item>
        <item name="android:colorAccent">@color/pm_accent</item>
        <item name="android:windowBackground">@color/pm_background</item>
        <item name="android:colorBackground">@color/pm_background</item>
        <item name="android:textColorPrimary">@color/pm_text</item>
        <item name="android:textColorSecondary">@color/pm_muted</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/pm_background</item>
        <item name="android:navigationBarColor">@color/pm_surface</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
