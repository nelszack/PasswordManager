{
  "manifest_version": 3,
  "name": "Password Manager",
  "version": "1.6",
  "version_name": "0.1.0",
  "description": "Securely connects websites to the local password manager",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "form_submission.js",
        "content_fields.js",
        "content_detection.js",
        "content_controls.js",
        "password_generator.js",
        "content_generator.js",
        "content_autofill.js",
        "content_bridge.js",
        "content_observer.js",
        "content_credentials.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
